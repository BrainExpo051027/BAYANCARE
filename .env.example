# Flask Configuration
SECRET_KEY=your-secure-secret-key-here

# Database Configuration (PostgreSQL)
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your-password@localhost/bayancare_db

# Gmail Configuration for Email Notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com

# Admin Configuration (Optional - for initial setup)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bayancare.local
# ADMIN_PASSWORD=leave-empty-to-generate-random-password
